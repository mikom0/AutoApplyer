# Optional LLM settings. The default CLI behavior is LLM off.
OPENAI_API_KEY=
AUTOAPPLYER_OPENAI_MODEL=gpt-4.1-mini

# Optional dedicated writing assistant settings.
AUTOAPPLYER_WRITING_PROVIDER=off
AUTOAPPLYER_WRITING_MODEL=gpt-4.1

# Optional default browser storage state. This file should be gitignored.
AUTOAPPLYER_STORAGE_STATE=.auth/workday-storage-state.json
